diff --git a/.githooks/pre-commit b/.githooks/pre-commit
new file mode 100755
index 0000000..22e724a
--- /dev/null
+++ b/.githooks/pre-commit
@@ -0,0 +1,12 @@
+#!/bin/sh
+# Keep this hook non-mutating: users retain control over what enters the index.
+if command -v python3 >/dev/null 2>&1; then
+  exec python3 scripts/update_source_urls.py --check
+elif command -v python >/dev/null 2>&1; then
+  exec python scripts/update_source_urls.py --check
+elif command -v py >/dev/null 2>&1; then
+  exec py -3 scripts/update_source_urls.py --check
+fi
+
+echo "Python 3 is required for the source URL pre-commit hook." >&2
+exit 1
diff --git a/.github/workflows/source-urls.yml b/.github/workflows/source-urls.yml
new file mode 100644
index 0000000..1a32026
--- /dev/null
+++ b/.github/workflows/source-urls.yml
@@ -0,0 +1,21 @@
+name: source URLs
+
+on:
+  push:
+  pull_request:
+
+permissions:
+  contents: read
+
+jobs:
+  check:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+      - name: Test source URL updater
+        run: python -m unittest scripts/test_update_source_urls.py
+      - name: Check source URL headers
+        run: python scripts/update_source_urls.py --check
diff --git a/README.md b/README.md
index 7e77a7b..003b1be 100644
--- a/README.md
+++ b/README.md
@@ -1,2 +1,27 @@
 # library
 https://maspypy.github.io/library/
+
+## Source URL headers
+
+Every tracked `.hpp` begins with its canonical GitHub URL. Update headers after
+adding or moving a header with:
+
+```sh
+python scripts/update_source_urls.py
+```
+
+To reject missing or stale headers without modifying files, use:
+
+```sh
+python scripts/update_source_urls.py --check
+```
+
+Enable the included local pre-commit check once per clone:
+
+```sh
+git config core.hooksPath .githooks
+```
+
+`expander.py` preserves source URL headers by default. Set
+`MASPY_STRIP_SOURCE_URL=1` to omit only those lines from expanded output; the
+existing `my_template.hpp` library attribution remains.
