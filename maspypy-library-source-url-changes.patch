+  vc<mint> g(n - d);
+  FOR(i, n - d) g[i] = f[d + i] * c;
+  g = fps_sqrt(g);
+  FOR(i, len(g)) g[i] *= x;
+  g.resize(n);
+  FOR_R(i, n) {
+    if (i >= d / 2)
+      g[i] = g[i - d / 2];
+    else
+      g[i] = 0;
+  }
+  return g;
+}
