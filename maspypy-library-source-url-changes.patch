+void print() { wt('\n'); }
+template <class Head, class... Tail>
+void print(Head &&head, Tail &&...tail) {
+  wt(forward<Head>(head));
+  ((wt(' '), wt(forward<Tail>(tail))), ...);
+  wt('\n');
