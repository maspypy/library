+// Source: https://github.com/maspypy/library/blob/main/setfunc/xor_convolution.hpp
+#include "setfunc/hadamard.hpp"
+
+template <typename T>
+vc<T> xor_convolution(vc<T> A, vc<T> B) {
+  hadamard(A);
+  hadamard(B);
+  FOR(i, len(A)) A[i] *= B[i];
+  hadamard(A);
+
+  T c = T(1) / T(len(A));
+  if (c != T(0)) {
+    FOR(i, len(A)) A[i] *= c;
+  } else {
+    FOR(i, len(A)) A[i] /= len(A);
+  }
+  return A;
+}
