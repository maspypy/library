+// Source: https://github.com/maspypy/library/blob/main/graph/tree_diameter.hpp
+#include "graph/shortest_path/bfs_01.hpp"
+#include "graph/shortest_path/restore_path.hpp"
+
+template <typename T, typename GT>
+pair<T, vc<int>> tree_diameter(GT& G) {
+  assert(G.is_prepared());
+  int A, B;
+  auto [distA, parA] = bfs_01<T>(G, 0);
+  A = max_element(all(distA)) - distA.begin();
+  auto [dist, par] = bfs_01<T>(G, A);
+  B = max_element(all(dist)) - dist.begin();
+  vc<int> P = restore_path(par, B);
+  return {dist[B], P};
+}
