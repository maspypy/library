+template <typename mint, typename F>
+vc<mint> blackbox_min_poly(int N, F f) {
+  vc<mint> S(N + N + 10);
+  vc<mint> c(N);
+  vc<mint> v(N);
+  FOR(i, N) c[i] = RNG(0, mint::get_mod());
+  FOR(i, N) v[i] = RNG(0, mint::get_mod());
+  FOR(k, N + N + 10) {
+    FOR(i, N) S[k] += c[i] * v[i];
+    v = f(v);
+  }
+  S = find_linear_rec(S);
+  reverse(all(S));
+  return S;
+}
