+      if (used[e.id]) continue;
+      if (par[e.to] != -2) dp[v]++, dp[e.to]--, used[e.id] = 1;
+      if (par[e.to] == -2) {
+        used[e.id] = 1;
+        par[e.to] = v;
+        dfs(dfs, e.to);
+      }
+    }
+  };
+  FOR(v, N) if (par[v] == -2) { par[v] = -1, dfs(dfs, v); }
+  FOR_R(i, N) {
+    if (par[V[i]] != -1) dp[par[V[i]]] += dp[V[i]];
+  }
+  for (auto&& v: V) comp[v] = (dp[v] == 0 ? n_comp++ : comp[par[v]]);
+  return {n_comp, comp};
 }
