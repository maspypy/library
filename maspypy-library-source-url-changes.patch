+                          bool check = true) {
+  init();
+  vc<int> V;
+  vc<bool> done(N);
+  auto dfs = [&](auto& dfs, int v) -> void {
+    set_used(v);
+    done[v] = 1;
+    while (1) {
+      int to = find_unused(v);
+      if (to == -1) break;
+      dfs(dfs, to);
+    }
+    V.eb(v);
+  };
+  FOR(v, N) if (!done[v]) dfs(dfs, v);
+  reverse(all(V));
+  if (check) {
+    init();
+    FOR_R(i, N) {
+      int v = V[i];
+      if (find_unused(v) != -1) {
+        return {};
+      }
+      set_used(v);
+    }
+  }
+  return V;
+}
